# Configure these values in Railway Variables. Do not commit a real .env file.
# For a chunked Railway session, use SESSION_ID_PARTS and SESSION_ID_1, SESSION_ID_2, ...
# For a legacy single session, use SESSION_ID.
SESSION_ID=

# Required only if the chatbot feature is enabled.
CHATBOT_FIREBASE_API_KEY=

# Required only for .emojimix.
TENOR_API_KEY=

# Required only for .smeme.
VOICY_API_KEY=

# Required only for .factcheck.
GOOGLE_FACTCHECK_API_KEY=

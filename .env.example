# Configure these values in Railway Variables. Do not commit a real .env file.
# For a chunked Railway session, use SESSION_ID_PARTS and SESSION_ID_1, SESSION_ID_2, ...
# For a legacy single session, use SESSION_ID.
SESSION_ID=

# Required for owner-only commands. Store digits only, including country code.
BOT_OWNER_NUMBER=
BOT_OWNER_NAME=

# API credentials. Leave a value empty to keep its related feature disabled.
XTEAM_API_KEY=
LOLHUMAN_API_KEY=
NEOXR_API_KEY=
VIOLETICS_API_KEY=
ZENZAPIS_API_KEY=
FGMODS_API_KEY=
NEWS_API_KEY=
TELEGRAM_BOT_TOKEN=
GIPHY_API_KEY=

# Required only if the chatbot feature is enabled.
CHATBOT_FIREBASE_API_KEY=

# Required only for .emojimix.
TENOR_API_KEY=

# Required only for .smeme.
VOICY_API_KEY=

# Required only for .factcheck.
GOOGLE_FACTCHECK_API_KEY=

# Pairing is disabled by default. Enable only on a private service and set a random token of at least 24 characters.
PAIRING_ENABLED=false
PAIRING_API_TOKEN=
